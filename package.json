{
  "name": "project001",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "node tests/browser.mjs",
    "predev": "node scripts/assets.mjs",
    "prebuild": "node scripts/assets.mjs",
    "format": "prettier --write src tests scripts *.ts *.json index.html docs README.md",
    "format:check": "prettier --check src tests scripts *.ts *.json index.html docs README.md"
  },
  "engines": {
    "node": "^24.0.0 || >=26.0.0"
  },
  "dependencies": {
    "@neslinesli93/qpdf-wasm": "^0.3.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "pptxgenjs": "^4.0.1",
    "tesseract.js": "^7.0.0",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "image-size": "2.0.3"
  }
}
